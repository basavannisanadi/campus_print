# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_API_KEY: Secret key for Owner-level APIs and signing shop admin tokens.
# Default: 'campusprint_admin_123' if omitted. Configure a strong random key in production.
ADMIN_API_KEY="campusprint_admin_123"

# AGENT_TOKEN: Shared secret authorization token for the Windows Print Agent client.
# Default: 'campusprint_agent_token_123' if omitted. Configure a strong random token in production.
AGENT_TOKEN="campusprint_agent_token_123"

# VITE_API_BASE_URL: The URL of the backend API server.
# Set this in your Cloudflare Pages environment variables.
# Example: "https://api.my-campus-print.com"
VITE_API_BASE_URL=""
